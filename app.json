{
  "expo": {
    "name": "Dagsverk",
    "slug": "dagsverk",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dagsverk",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "no.dagsverk.app",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "Brukes til å dokumentere arbeid på byggeplass med bilder og video.",
        "NSPhotoLibraryUsageDescription": "Brukes til å legge ved bilder fra galleriet i dagsrapporter.",
        "NSLocationWhenInUseUsageDescription": "Registrerer hvor en rapport ble opprettet, som dokumentasjon. Kan slås av.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "no.dagsverk.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F1417",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA", "android.permission.ACCESS_FINE_LOCATION"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F1417",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
