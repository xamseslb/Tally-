# Kopier til .env og fyll inn. .env committes ALDRI (se .gitignore).
# EXPO_PUBLIC_* er tilgjengelig i klienten — legg ALDRI hemmeligheter her.
# service_role-nøkkel hører kun hjemme i Edge Functions (CLAUDE.md regel #7).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SENTRY_DSN=
